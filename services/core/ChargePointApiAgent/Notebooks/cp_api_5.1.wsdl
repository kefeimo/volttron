<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:css="urn:provider/interface/chargepointservices/"
    xmlns:tns="urn:dictionary:com.chargepoint.webservices"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="chargepointservices" targetNamespace="urn:dictionary:com.chargepoint.webservices">
    <wsdl:types>
        <xsd:schema targetNamespace="urn:dictionary:com.chargepoint.webservices">
            <!-- Station Information APIs (2) -->
            <xsd:element name="getPublicStations">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="searchQuery" type="tns:stationSearchRequest" minOccurs="1" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getPublicStationsResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="responseCode" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="responseText" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="stationData" type="tns:stationData" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="moreFlag" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:complexType name="stationSearchRequest">
                <!-- This schema for searching stations for getPublicStations ....  -->
                <xsd:all>
                    <xsd:element name="stationID" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationManufacturer" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationModel" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationName" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="serialNumber" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Address" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="City" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="State" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Country" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="postalCode" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Proximity" type="xsd:double" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="proximityUnit" type="xsd:string" minOccurs="0" maxOccurs="1" default ="M"/>
                    <xsd:element name="Connector" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Voltage" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Current" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Power" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="demoSerialNumber" type="tns:serialNumberData" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Reservable" type="xsd:boolean" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Geo" type="tns:geoData" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Level" minOccurs="0" maxOccurs="1"  type="xsd:string" />
                    <!-- Possible values L1, L2 and DC -->
                    <xsd:element name="Mode" minOccurs="0" maxOccurs="1"  type="xsd:string" />
                    <xsd:element name="Pricing" minOccurs="0" maxOccurs="1" type="tns:pricingOptions" />
                    <!-- pagination in get public stations call  -->
                    <xsd:element name="startRecord" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="numStations" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                </xsd:all>
            </xsd:complexType>
            <xsd:complexType name="geoData">
                <!-- Complex Data type for GeoCodes (Lat/Long, both are mandatory) -->
                <xsd:all>
                    <xsd:element name="Lat" type="xsd:string"  minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="Long" type="xsd:string"  minOccurs="1" maxOccurs="1"/>
                </xsd:all>
            </xsd:complexType>
            <xsd:complexType name="pricingOptions">
                <xsd:all>
                    <xsd:element name="startTime" type="xsd:time"  minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="Duration" type="xsd:int"  minOccurs="1" maxOccurs="1"/>
                    <!-- Expected duration of charging session in minutes -->
                    <xsd:element name="energyRequired" type="xsd:double"  minOccurs="1" maxOccurs="1"/>
                    <!-- In Kwh -->
                    <xsd:element name="vehiclePower" type="xsd:double"  minOccurs="1" maxOccurs="1"/>
                    <!-- In Kw -->
                </xsd:all>
            </xsd:complexType>
            <xsd:complexType name="serialNumberData">
                <xsd:sequence>
                    <xsd:element name="serialNumber" type="xsd:string"  minOccurs="1" maxOccurs="unbounded" />
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="stationData">
                <xsd:sequence>
                    <xsd:element name="stationID" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationManufacturer" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationModel" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationMacAddr" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationSerialNum" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <!-- Maneesh: CPSRV-6468 - getStations does not capture port 1A & 1B -->
                    <xsd:element name="stationName" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Address" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="City" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="State" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Country" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="postalCode" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Port" minOccurs="0" maxOccurs="unbounded" type="tns:portData" />
                    <xsd:element name="Pricing" type="tns:pricingSpecification" minOccurs="0" maxOccurs="2" />
                    <xsd:element name="numPorts" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="mainPhone" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="modTimeStamp" type="xsd:dateTime" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="timezoneOffset" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="currencyCode" type="tns:currencyCodeType" minOccurs="0" maxOccurs="1"/>
                    <!-- Tapan: CPSRV-32937 - Add record number to response -->
                    <xsd:element name="recordNumber" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
            
            <xsd:complexType name="getStationData">
                <xsd:sequence>
                    <xsd:element name="recordNumber" type="xsd:int" minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="stationID" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationManufacturer" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationModel" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationMacAddr" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationSerialNum" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <!-- Maneesh: CPSRV-6468 - getStations does not capture port 1A & 1B -->
                    <xsd:element name="stationName" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Description" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationActivationDate" type="xsd:dateTime" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Address" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="City" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="State" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Country" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="postalCode" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Port" minOccurs="0" maxOccurs="unbounded" type="tns:portData" />
                    <xsd:element name="Pricing" type="tns:pricingSpecification" minOccurs="0" maxOccurs="2" />
                    <xsd:element name="numPorts" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="driverName" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="driverAddress" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="driverEmail" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="driverPhoneNumber" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="lastModifiedDate" type="xsd:dateTime" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="mainPhone" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="modTimeStamp" type="xsd:dateTime" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="timezoneOffset" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="currencyCode" type="tns:currencyCodeType" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="warrantyExpirationDate" type="xsd:dateTime" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="warrantyService" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="warrantyType" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <!-- PallaviB : CPSRV-20265 <servicePlanExpiryDate> & <demo> response parameters to getStations method in API -->
                    <xsd:element name="servicePlanExpiryDate" type="xsd:date" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="servicePlanAutoRenewDate" type="xsd:date" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="demo" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
            
            
            <xsd:complexType name="pricingSpecification">
                <xsd:sequence>
                    <xsd:element name="Type" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="startTime" type="xsd:time"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="endTime" type="xsd:time"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="minPrice" type="xsd:double"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="maxPrice" type="xsd:double"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="initialUnitPriceDuration" type="xsd:int"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="unitPricePerHour" type="xsd:double"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="unitPricePerHourThereafter" type="xsd:double"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="unitPricePerSession" type="xsd:double"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="unitPricePerKWh" type="xsd:double"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="sessionTime" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="portData">
                <xsd:sequence>
                    <xsd:element name="portNumber" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Geo" type="tns:geoData" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Reservable" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Status" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Level"  type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="timeStamp" type="xsd:dateTime" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Mode" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Connectors" minOccurs="0" maxOccurs="unbounded" type="tns:Connectors" />
                    <xsd:element name="Connector" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Voltage" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Current" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Power" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="estimatedCost" type="xsd:double"  minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
            <!-- Maneesh: CPSRV-6468 - getStations does not capture port 1A & 1B -->
            <xsd:complexType name="Connectors">
                <xsd:sequence>
                    <xsd:element name="Connector" minOccurs="1" maxOccurs="unbounded" type="tns:Connector" />
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="Connector">
                <xsd:sequence>
                    <xsd:element name="connectorLabel" minOccurs="0" maxOccurs="1" type="xsd:string" />
                    <xsd:element name="connectorStatus" minOccurs="0" maxOccurs="1" type="xsd:string" />
                    <xsd:element name="connectorFaultReason" minOccurs="0" maxOccurs="1" type="xsd:string" />
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="getPublicStationStatus">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="searchQuery" type="tns:statusSearchdata" minOccurs="1" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getPublicStationStatusResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="responseCode" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="responseText" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <!-- renamed and created separate type for publicly available data -->
                        <xsd:element name="stationStatusData" type="tns:publicStatusdata" minOccurs="0" maxOccurs="unbounded"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:complexType name="statusSearchdata">
                <!-- This schema for searching stations for getPublicStationStatus ....  -->
                <xsd:all>
                    <xsd:element name="stationID" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationIDs" type="tns:stationIdList" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="stationManufacturer" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationModel" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationName" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Address" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="City" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="State" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Country" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="postalCode" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Proximity" type="xsd:double" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="proximityUnit" type="xsd:string" minOccurs="0" maxOccurs="1" default ="M"/>
                    <xsd:element name="Connector" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Voltage" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Current" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Power" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="portDetails" type="xsd:boolean" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="demoSerialNumber" type="tns:serialNumberData" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Reservable" type="xsd:boolean" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Geo" type="tns:geoData" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Status" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <!-- Possible values 1 is Available, 2 is InUse, 3 is Unknown -->
                    <xsd:element name="Level" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <!-- Possible values L1, L2 and DC -->
                    <xsd:element name="Mode" type="xsd:string" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Pricing" type="tns:pricingOptions" minOccurs="0" maxOccurs="1" />
                </xsd:all>
            </xsd:complexType>
            <xsd:element name="getStationStatus">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="searchQuery" type="tns:statusSearchdataForGetStations" minOccurs="1" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getStationStatusResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="responseCode" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="responseText" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="stationData" type="tns:oStatusdata" minOccurs="0" maxOccurs="unbounded"/>
                        <xsd:element name="moreFlag" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:complexType name="statusSearchdataForGetStations">
                <!-- This schema for searching stations extension....  -->
                <xsd:all>
                    <xsd:element name="stationID" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationIDs" type="tns:stationIdList" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="stationManufacturer" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationModel" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="stationName" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Address" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="City" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="State" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Country" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="postalCode" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Proximity" type="xsd:double" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="proximityUnit" type="xsd:string" minOccurs="0" maxOccurs="1" default ="M"/>
                    <xsd:element name="Connector" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Voltage" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Current" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Power" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="portDetails" type="xsd:boolean" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="demoSerialNumber" type="tns:serialNumberData" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Reservable" type="xsd:boolean" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Geo" type="tns:geoData" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Status" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <!-- Possible values 1 is Available, 2 is InUse, 3 is Unknown -->
                    <xsd:element name="Level" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                    <!-- Possible values L1, L2 and DC -->
                    <xsd:element name="Mode" type="xsd:string" minOccurs="0" maxOccurs="1" />
                    <xsd:element name="Pricing" type="tns:pricingOptions" minOccurs="0" maxOccurs="1" />
                    <!-- pagination in get stations call  -->
                    <xsd:element name="startRecord" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="numStations" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                </xsd:all>
            </xsd:complexType>
            <xsd:complexType name="stationIdList">
                <xsd:sequence>
                    <xsd:element name="stationID" type="xsd:string"  minOccurs="1" maxOccurs="unbounded" />
                </xsd:sequence>
            </xsd:complexType>
            <!-- Rohit : CPSRV-18014 : Allow a bounded list of station ids -->
            <xsd:complexType name="stationIdListBound">
                <xsd:sequence>
                    <xsd:element name="stationID" type="xsd:string"  minOccurs="1" maxOccurs="100" />
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="oStatusdata">
                <xsd:sequence>
                    <xsd:element name="stationID" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="Port" type="tns:portDataStatus" minOccurs="1" maxOccurs="unbounded" />
                    <!-- CPSRV-9428: Augment getStationStatus Method in the 5.1 API -->
                    <xsd:element name="recordNumber" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="networkStatus" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- created separate type publicStatusdata from oStatusdata for publicly available data -->
            <xsd:complexType name="publicStatusdata">
                <xsd:sequence>
                    <xsd:element name="stationID" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="Port" type="tns:publicPortDataStatus" minOccurs="1" maxOccurs="unbounded" />
                    <xsd:element name="recordNumber" type="xsd:int" minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="portDataStatus">
                <xsd:sequence>
                    <xsd:element name="portNumber" type="xsd:string"  minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="Status" type="xsd:string"  minOccurs="1" maxOccurs="1"/>
                    <!-- CPSRV-12551 - As an API User I want to get the fault reason in getStationStatus if a port is out of service -->
                    <xsd:element name="faultReason" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="TimeStamp" type="xsd:dateTime" minOccurs="1" maxOccurs="1" />
                    <!-- Maneesh: CPSRV-6468 - getStations does not capture port 1A & 1B -->
                    <xsd:element name="Connectors" minOccurs="0" maxOccurs="unbounded" type="tns:Connectors" />
                    <xsd:element name="Connector" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Power" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
            <!-- created separate type publicPortDataStatus from portDataStatus for publicly available data -->
            <xsd:complexType name="publicPortDataStatus">
                <xsd:sequence>
                    <xsd:element name="portNumber" type="xsd:string"  minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="Status" type="xsd:string"  minOccurs="1" maxOccurs="1"/>
                    <xsd:element name="TimeStamp" type="xsd:dateTime" minOccurs="1" maxOccurs="1" />
                    <!-- Maneesh: CPSRV-6468 - getStations does not capture port 1A & 1B -->
                    <xsd:element name="Connectors" minOccurs="0" maxOccurs="unbounded" type="tns:Connectors" />
                    <xsd:element name="Connector" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                    <xsd:element name="Power" type="xsd:string"  minOccurs="0" maxOccurs="1"/>
                </xsd:sequence>
            </xsd:complexType>
            <!-- Network Management APIs (2) -->
            <xsd:element name="getAlarms">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="searchQuery" type="tns:getAlarmsSearchQuery" minOccurs="1" maxOccurs="1"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
            <xsd:element name="getAlarmsResponse">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="responseCode" type="xsd:string" minOccurs="1" maxOccurs="1"/>
                        <xsd:element name="responseText" type="xsd:string" minOccurs="0" maxOccurs="1"/>
                        <xsd:element name="Alarms" type="tns:oalarms"  minOccurs="0"  maxOccurs="unbounded"/>
                        <xsd:element name="moreFlag" type="xsd:int"  minOccurs="0"  maxOccurs="1"/>
                    </xsd:sequence>
